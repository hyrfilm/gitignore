def find_gitignore():
    """Walk up from cwd to find the repo root and its .gitignore."""
    cwd = os.path.abspath(os.getcwd())
    path = cwd
    while True:
        # .git is a directory in a normal checkout, a file in worktrees/submodules.
        if os.path.exists(os.path.join(path, ".git")):
            return os.path.join(path, ".gitignore")
        parent = os.path.dirname(path)
        if parent == path:
            # No .git found; fall back to cwd
            return os.path.join(cwd, ".gitignore")
        path = parent


def read_patterns(gitignore_path):
    """Return a set of non-comment, non-empty lines from .gitignore."""
    if not os.path.exists(gitignore_path):
        return set()
    with open(gitignore_path) as f:
        lines = f.readlines()
    return {l.strip() for l in lines if l.strip() and not l.strip().startswith("#")}


def append_patterns(gitignore_path, patterns, label=None):
    """Append patterns that aren't already present. Returns (added, skipped) lists."""
    existing = read_patterns(gitignore_path)
    to_add = []
    skipped = []
    for p in patterns:
        if p in existing or p in to_add:
            skipped.append(p)
        else:
            to_add.append(p)

    if to_add:
        with open(gitignore_path, "a") as f:
            # Ensure file ends with newline before appending
            if os.path.getsize(gitignore_path) > 0:
                with open(gitignore_path, "rb") as rf:
                    rf.seek(-1, 2)
                    last = rf.read(1)
                if last != b"\n":
                    f.write("\n")
            if label:
                f.write(f"\n# {label}\n")
            for p in to_add:
                f.write(p + "\n")

    return to_add, skipped


def git_ls(args):
    """Run git ls-files with ARGS; return matching paths, or [] if git errored."""
    result = subprocess.run(
        ["git", "ls-files", "-z"] + args,
        capture_output=True, text=True
    )
    if result.returncode != 0:
        return []
    return [f for f in result.stdout.split("\0") if f]


def git_untrack(patterns):
    """Untrack files that are tracked but now ignored by PATTERNS."""
    try:
        # -i needs -c (or -o) or git refuses: list tracked-but-ignored files.
        # ":/" widens the search to the whole repo -- without it git only looks
        # below the cwd, so running from a subdirectory would miss most of it.
        files = git_ls(["--cached", "--ignored", "--exclude-standard", "--", ":/"])
        if not files:
            # Fallback: match the patterns as pathspecs. Leading "/" anchors a
            # .gitignore pattern to the repo root but is not valid in a pathspec.
            pathspecs = [":/" + p.lstrip("/") for p in patterns if p.strip("/")]
            if pathspecs:
                files = git_ls(["--"] + pathspecs)
        if files:
            subprocess.run(["git", "rm", "--cached", "--quiet", "-r", "--ignore-unmatch"] + files)
            print(f"  Untracked {len(files)} file(s) from git index.")
        else:
            print("  No tracked files matched (nothing to untrack).")
    except FileNotFoundError:
        print("  Warning: git not found, skipping untrack step.")


def remove_pattern(gitignore_path, pattern):
    """Remove a pattern line from .gitignore."""
    if not os.path.exists(gitignore_path):
        print(f"No .gitignore found at {gitignore_path}")
        return False
    with open(gitignore_path) as f:
        lines = f.readlines()
    new_lines = [l for l in lines if l.strip() != pattern]
    if len(new_lines) == len(lines):
        print(f"Pattern '{pattern}' not found in {gitignore_path}")
        return False
    with open(gitignore_path, "w") as f:
        f.writelines(new_lines)
    print(f"Removed '{pattern}' from {gitignore_path}")
    return True


def add_patterns(gitignore_path, patterns, label=None):
    """Append PATTERNS under LABEL, report the result and untrack newly ignored files."""
    added, skipped = append_patterns(gitignore_path, patterns, label=label)
    tag = f" ({label})" if label else ""
    if added:
        print(f"Added{tag} to {gitignore_path}: {', '.join(added)}")
    if skipped:
        print(f"Already ignored{tag}: {', '.join(skipped)}")
        if not label:
            print("  To change a pattern, run: gitignore --undo <pattern> && gitignore <new-pattern>")
    if added:
        git_untrack(added)


def main():
    parser = argparse.ArgumentParser(
        description="Manage .gitignore from anywhere in your repo.",
        add_help=True,
    )
    parser.add_argument("patterns", nargs="*", help="Pattern(s) to add to .gitignore")
    parser.add_argument("--undo", metavar="PATTERN", help="Remove a pattern from .gitignore")
    parser.add_argument("--list", action="store_true", help="Show .gitignore contents")
    for flag, lang in LANGUAGES.items():
        parser.add_argument(f"--{flag}", action="store_true", help=lang.help)

    args = parser.parse_args()

    gitignore_path = find_gitignore()

    # --list
    if args.list:
        if not os.path.exists(gitignore_path):
            print(f"No .gitignore at {gitignore_path}")
        else:
            print(f"# {gitignore_path}")
            with open(gitignore_path) as f:
                print(f.read(), end="")
        return

    # --undo
    if args.undo:
        remove_pattern(gitignore_path, args.undo)
        return

    requested = [lang for flag, lang in LANGUAGES.items() if getattr(args, flag.replace("-", "_"))]
    if not requested and not args.patterns:
        parser.print_help()
        return

    for lang in requested:
        add_patterns(gitignore_path, lang.patterns, label=lang.label)
    if args.patterns:
        add_patterns(gitignore_path, args.patterns)


if __name__ == "__main__":
    main()
